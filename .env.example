HOST=127.0.0.1
GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_PORT=4000
BACKEND_URL=http://127.0.0.1:4001
BACKEND_PORT=4001
MEDIA_WORKER_PORT=4200
DATABASE_URL=postgresql://template:template@localhost:5432/template
REDIS_URL=redis://localhost:6379
# Temporal frontend (gRPC). Required in production; Compose full stack uses temporal:7233.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Public origin of the web app: Better Auth baseURL/trustedOrigins, JWT issuer, Google callback.
WEB_ORIGIN=http://localhost:3000
# Generate real values with `openssl rand -base64 32`. Production rejects values containing "dev-only".
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-00000000
INTERNAL_AUTH_SECRET=dev-only-internal-auth-secret-change-me-0000000
GATEWAY_TICKET_SECRET=dev-only-gateway-ticket-secret-change-me-00000000
GATEWAY_PUBLIC_URL=http://localhost:4000
REALTIME_MAX_CONNECTION_SECONDS=3600
# Google login is enabled only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production: CIDR of the proxy/load balancer in front of the gateway, e.g. 10.0.0.0/8.
# TRUST_PROXY=
# Integration tests: use a separate database (e.g. template_test) so tests never touch dev data.
# TEST_DATABASE_URL=postgresql://template:template@localhost:5432/template_test
# S3-compatible object storage (SeaweedFS / AWS S3 / Cloudflare R2).
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=creative-dev
S3_SECRET_KEY=creative-dev-secret-0123456789abcdef
S3_BUCKET=creative-assets
S3_CONFIGURE_CORS=true
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=custom-service
# Agent loop configuration
AGENT_MODEL=mock
AGENT_MOCK_CHUNK_DELAY_MS=40
AGENT_REGION=default
# AGENT_SKILLS_DIR=
