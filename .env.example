HOST=127.0.0.1
GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_PORT=4000
BACKEND_URL=http://127.0.0.1:4001
BACKEND_PORT=4001
AGENT_RUNNER_PORT=4100
MEDIA_WORKER_PORT=4200
DATABASE_URL=postgresql://template:template@localhost:5432/template
REDIS_URL=redis://localhost:6379
# Public origin of the web app: Better Auth baseURL/trustedOrigins, JWT issuer, Google callback.
WEB_ORIGIN=http://localhost:3000
# Generate real values with `openssl rand -base64 32`. Production rejects values containing "dev-only".
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-00000000
INTERNAL_AUTH_SECRET=dev-only-internal-auth-secret-change-me-0000000
# Google login is enabled only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production: CIDR of the proxy/load balancer in front of the gateway, e.g. 10.0.0.0/8.
# TRUST_PROXY=
# Integration tests: use a separate database (e.g. template_test) so tests never touch dev data.
# TEST_DATABASE_URL=postgresql://template:template@localhost:5432/template_test
# Configure after adding an S3-compatible storage adapter.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=custom-service
