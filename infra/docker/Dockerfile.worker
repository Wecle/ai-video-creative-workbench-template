FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /app

RUN pip install --no-cache-dir uv==0.8.22
COPY workers/media-worker-python/pyproject.toml workers/media-worker-python/uv.lock ./
RUN uv sync --frozen --no-dev
COPY workers/media-worker-python/src ./src

RUN useradd --create-home --uid 10001 worker
RUN chown -R worker:worker /app
USER worker

EXPOSE 4200
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "4200"]
