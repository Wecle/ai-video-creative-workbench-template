{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "GATEWAY_URL",
        "HOST",
        "GATEWAY_PORT",
        "BACKEND_URL",
        "BACKEND_PORT",
        "WEB_ORIGIN",
        "REDIS_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "INTERNAL_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "TRUST_PROXY",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "NEXT_TELEMETRY_DISABLED",
        "GATEWAY_TICKET_SECRET",
        "GATEWAY_PUBLIC_URL",
        "REALTIME_MAX_CONNECTION_SECONDS",
        "S3_ENDPOINT",
        "S3_PUBLIC_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "S3_CONFIGURE_CORS",
        "AGENT_MODEL",
        "AGENT_MOCK_CHUNK_DELAY_MS",
        "AGENT_REGION",
        "AGENT_SKILLS_DIR"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["GATEWAY_URL", "BACKEND_URL"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [],
      "env": [
        "TEST_DATABASE_URL",
        "REDIS_URL",
        "CI",
        "S3_ENDPOINT",
        "S3_PUBLIC_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "AGENT_MODEL",
        "AGENT_MOCK_CHUNK_DELAY_MS",
        "AGENT_REGION",
        "AGENT_SKILLS_DIR"
      ],
      "passThroughEnv": ["DATABASE_URL", "TEMPORAL_CLI_PATH"]
    }
  }
}
