{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "assetKey": { "type": "string", "minLength": 1 },
      "contentType": { "type": "string", "minLength": 1 },
      "sizeBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "downloadUrl": { "type": "string", "format": "uri" }
    },
    "required": ["assetKey", "contentType", "sizeBytes"],
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "assetKey": { "type": "string", "minLength": 1 },
      "kind": { "type": "string", "minLength": 1 },
      "contentType": { "type": "string", "minLength": 1 },
      "sizeBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "probedBy": { "type": "string", "const": "media-worker-python" },
      "pythonVersion": { "type": "string", "minLength": 1 }
    },
    "required": [
      "assetKey",
      "kind",
      "contentType",
      "sizeBytes",
      "probedBy",
      "pythonVersion"
    ],
    "additionalProperties": false
  }
}
