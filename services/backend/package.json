{
  "name": "@creative/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "auth generate --config src/auth/cli.ts --adapter drizzle --dialect pg --output ../../packages/database/src/auth-schema.ts -y"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@creative/canvas-doc": "workspace:*",
    "@creative/contracts": "workspace:*",
    "@creative/database": "workspace:*",
    "@creative/node-registry": "workspace:*",
    "@creative/observability": "workspace:*",
    "@creative/providers": "workspace:*",
    "@creative/storage": "workspace:*",
    "@creative/workflows": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@temporalio/client": "catalog:",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "catalog:",
    "postgres": "^3.4.7",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@temporalio/testing": "catalog:",
    "@temporalio/worker": "catalog:",
    "auth": "^1.7.12",
    "jose": "^6.2.13",
    "tsup": "catalog:",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
