{
  "name": "@creative/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "auth generate --config src/auth/cli.ts --adapter drizzle --dialect pg --output ../../packages/database/src/auth-schema.ts -y"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@creative/canvas-doc": "workspace:*",
    "@creative/contracts": "workspace:*",
    "@creative/database": "workspace:*",
    "@creative/node-registry": "workspace:*",
    "@creative/observability": "workspace:*",
    "@creative/providers": "workspace:*",
    "@creative/workflows": "workspace:*",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@temporalio/client": "catalog:",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^6.0.0",
    "postgres": "^3.4.7",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@temporalio/testing": "catalog:",
    "@temporalio/worker": "catalog:",
    "auth": "^1.7.7",
    "jose": "^6.2.12",
    "tsup": "catalog:",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
